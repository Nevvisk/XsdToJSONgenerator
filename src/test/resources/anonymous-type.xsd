<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://test.com/anonymous"
           xmlns:tns="http://test.com/anonymous">

    <!-- Element with anonymous complex type -->
    <xs:element name="address">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="street" type="xs:string"/>
                <xs:element name="city" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- Element with simple type (for comparison) -->
    <xs:element name="greeting" type="xs:string"/>

</xs:schema>
